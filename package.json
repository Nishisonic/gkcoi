{
  "name": "gkcoi",
  "version": "1.7.2",
  "description": "Generate KanColle Organization Image",
  "main": "dist/index.js",
  "module": "esm/index.js",
  "sideEffects": false,
  "scripts": {
    "build": "npm run build:cjs && npm run build:esm",
    "build:cjs": "tsc -p tsconfig.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "watch": "webpack -w"
  },
  "files": [
    "esm",
    "dist",
    "!dist/bundle.js"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nishisonic/gkcoi.git"
  },
  "keywords": [
    "kancolle"
  ],
  "author": "Nishisonic(Nishikuma)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Nishisonic/gkcoi/issues"
  },
  "homepage": "https://github.com/Nishisonic/gkcoi#readme",
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.6",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "webpack": "5.109.2",
    "webpack-cli": "^7.2.2"
  },
  "dependencies": {
    "aaci-prop": "^1.2.45",
    "chart.js": "^3.9.1",
    "chartjs-plugin-datalabels": "^2.2.0",
    "dotenv": "^17.4.2",
    "lz-string": "^1.5.0",
    "replicate": "^1.4.0",
    "ts-steganography": "^3.0.2"
  }
}
